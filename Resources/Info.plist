<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>SoundCast</string>
	<key>CFBundleDisplayName</key>
	<string>SoundCast</string>
	<key>CFBundleIdentifier</key>
	<string>com.soundcast.app</string>
	<key>CFBundleExecutable</key>
	<string>SoundCast</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.1</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<!-- Menu-bar-only app: no Dock icon, no app menu bar of its own. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Drives the one-time system consent prompt for the Core Audio
	     process-tap capture (design doc §2) — same family of prompt as
	     microphone access, worded for what we're actually doing. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>SoundCast needs to capture system audio so it can play what you're hearing on the speakers and rooms you select.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SoundCast listens to a few test clicks to line up your speakers (Calibrate). Nothing is recorded or sent anywhere.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SoundCast discovers and connects to AirPlay receivers on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_sonos._tcp</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>NSHumanReadableCopyright</key>
	<string>Personal project — not for distribution.</string>
</dict>
</plist>
